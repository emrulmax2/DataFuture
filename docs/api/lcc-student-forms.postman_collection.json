                  "description": "Optional. Send the app name and version."
                },
                {
                  "key": "device_screen",
                  "value": "390x844",
                  "type": "text",
                  "description": "Optional."
                },
                {
                  "key": "documents[]",
                  "type": "file",
                  "src": [],
                  "description": "Optional. Up to 5 files, 5MB each, pdf/doc/docx/jpg/jpeg/png. Tick the row and pick a file to test.",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/student/forms/course-change",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "student",
                "forms",
                "course-change"
              ]
